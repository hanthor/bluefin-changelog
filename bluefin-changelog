# ── Data helpers ──────────────────────────────────────────────────────────────

def parse_args():
    p = argparse.ArgumentParser(description="Show Bluefin Dakota pending update changelog")
    p.add_argument("--html", metavar="FILE", help="Export to HTML file instead of terminal")
    p.add_argument("--open", action="store_true", help="Generate HTML and open in browser")
    return p.parse_args()


def get_bootc_status():
    r = subprocess.run(["sudo", "bootc", "status", "--format", "json"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        print("Error: could not run 'sudo bootc status'", file=sys.stderr)
        sys.exit(1)
    return json.loads(r.stdout)


CACHE_DIR = os.path.expanduser("~/.cache/bluefin-changelog")

def _cache_path(key):
    safe = re.sub(r'[^a-zA-Z0-9_.-]', '_', key)
    return os.path.join(CACHE_DIR, safe + ".json")

def _cache_get(key, max_age_s=3600):
    path = _cache_path(key)
    try:
        if time.time() - os.path.getmtime(path) < max_age_s:
            with open(path) as f:
                return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        pass
    return None

def _cache_put(key, data):
    os.makedirs(CACHE_DIR, exist_ok=True)
    with open(_cache_path(key), "w") as f:
        json.dump(data, f)

def fetch_json(url, cache_key=None, max_age_s=3600):
    if cache_key:
        cached = _cache_get(cache_key, max_age_s)
        if cached is not None:
            return cached
    req = urllib.request.Request(
        url, headers={"User-Agent": "bluefin-changelog/1.0", "Accept": "application/json"}
    )
    with urllib.request.urlopen(req) as resp:
        data = json.loads(resp.read())
    if cache_key:
        _cache_put(cache_key, data)
    return data


def fetch_releases():
    return fetch_json(f"{API_BASE}/{REPO}/releases?per_page=30",
                      cache_key="releases", max_age_s=1800)


def find_release_for_date(releases, date_str):
    for r in releases:
        if r["tag_name"].startswith(date_str):
            return r
    dt = datetime.strptime(date_str, "%Y-%m-%d")
    for delta in [1, -1, 2, -2, 3, -3, 4, -4]:
        candidate = (dt + timedelta(days=delta)).strftime("%Y-%m-%d")
        for r in releases:
            if r["tag_name"].startswith(candidate):
                return r
    return None


def download_sbom(release):
    tag = release["tag_name"]
    cached = _cache_get(f"sbom_{tag}", max_age_s=86400 * 7)
    if cached is not None:
        return cached
    assets = fetch_json(release["assets_url"],
                        cache_key=f"assets_{tag}", max_age_s=86400)
    for asset in assets:
        if asset["name"].endswith(".spdx.json"):
            req = urllib.request.Request(
                asset["browser_download_url"],
                headers={"User-Agent": "bluefin-changelog/1.0"}
            )
            with urllib.request.urlopen(req) as resp:
                data = json.loads(resp.read())
            _cache_put(f"sbom_{tag}", data)
            return data
    return None


def extract_packages(sbom):
    pkgs = {}
    for p in sbom.get("packages", []):
        name = p.get("name", "")
        ver = p.get("versionInfo", "")
        src = p.get("sourceInfo", "")
        if not ver or not name:
            continue
        if HASH_RE.match(ver) or HASH_RE.match(name):
            continue
        if name.startswith("/"):
            continue
        if src in INTERESTING_SOURCES or re.match(r'^\d+\.\d+', ver):
            pkgs[name] = ver
    return pkgs


def parse_key_components(body):
    components = {}
    in_section = False
    saw_table = False
    for line in body.splitlines():
        if "Key component versions" in line:
            in_section = True
            saw_table = False
            continue
        if not in_section:
            continue
        stripped = line.strip()
        if stripped.startswith("|") and "---" in stripped:
            continue
        if stripped.startswith("|") and "Component" in stripped:
            saw_table = True
            continue
        if stripped.startswith("|"):
            saw_table = True
            parts = [p.strip() for p in stripped.strip("|").split("|")]
            if len(parts) >= 3:
                name = parts[0].strip()
                ver = parts[1].strip().strip("`")
                change = parts[2].strip()
                if name and ver:
                    components[name] = {"version": ver, "change": change}
        elif saw_table and stripped == "":
            in_section = False
    return components


def diff_packages(old_pkgs, new_pkgs):
    added = {k: v for k, v in new_pkgs.items() if k not in old_pkgs}
    removed = {k: v for k, v in old_pkgs.items() if k not in new_pkgs}
    changed = {
        k: (old_pkgs[k], new_pkgs[k])
        for k in new_pkgs
        if k in old_pkgs and old_pkgs[k] != new_pkgs[k]
    }
    return added, removed, changed


def format_date(date_str):
    try:
        return datetime.strptime(date_str, "%Y-%m-%d").strftime("%B %-d, %Y")
    except Exception:
        return date_str


# ── HTML generation ───────────────────────────────────────────────────────────

def h(s):
    return html_mod.escape(str(s))


def chip_html(name, ver, old_ver=None):
    """Render a version chip, optionally as a link with old→new display."""
    changed = old_ver is not None and old_ver != ver
    url = component_url(name, ver, old_ver if changed else None)

    classes = "versionChip_TGoY" + (" chipChanged_q9Uf" if changed else "")
    old_span = (f'<span class="chipOld_vZzQ">{h(old_ver)}</span>' if changed else "")
    arrow    = (f'<span class="chipUpdated_MZXy">↑</span>' if changed else "")

    inner = (
        f'<span class="chipLabel_jCCv">{h(name)}</span>'
        f'{old_span}'
        f'<span class="chipValue_k66W">{h(ver)}</span>'
        f'{arrow}'
    )
    if url:
        title = f"Compare {h(old_ver)} → {h(ver)}" if changed else f"Release notes for {h(ver)}"
        return f'<a class="{classes}" href="{h(url)}" target="_blank" title="{title}">{inner}</a>'
    return f'<span class="{classes}">{inner}</span>'


def sbom_pkg_link(name):
    """Best-effort link for an SBOM package name to its upstream."""
    # Map common SBOM names → GitHub repos
    SBOM_LINKS = {
        "ghostty":   ("release", "ghostty-org/ghostty", lambda v: f"v{v}"),
        "fish":      ("release", "fish-shell/fish-shell", lambda v: v),
        "podman":    ("release", "containers/podman", lambda v: f"v{v}"),
        "flatpak":   ("release", "flatpak/flatpak", lambda v: v),
        "systemd":   ("release", "systemd/systemd", lambda v: f"v{v}"),
        "fzf":       ("release", "junegunn/fzf", lambda v: f"v{v}"),
        "gum":       ("release", "charmbracelet/gum", lambda v: f"v{v}"),
        "glow":      ("release", "charmbracelet/glow", lambda v: f"v{v}"),
        "distrobox": ("release", "89luca89/distrobox", lambda v: v),
        "bootc":     ("release", "containers/bootc", lambda v: f"v{v}"),
    }
    return SBOM_LINKS.get(name.lower())


def diff_section_html(label, count_class, rows_html, cols):
    count = len(rows_html)
    if not count:
        return ""
    thead = "".join(f"<th>{c}</th>" for c in cols)
    tbody = "".join(rows_html)
    return f"""
<div class="diff-block">
  <div class="diff-block-heading">
    {h(label)}
    <span class="diff-count {count_class}">{count}</span>
  </div>
  <table class="diff-table">
    <thead><tr>{thead}</tr></thead>
    <tbody>{tbody}</tbody>
  </table>
</div>"""


def generate_html(
    booted_date, staged_date, booted_digest, staged_digest,
    staged_release, key_components,
    changed, added, removed,
    sbom_note, from_tag, to_tag,
    output_path
):
    tag     = staged_release["tag_name"]
    gh_url  = f"https://github.com/{REPO}/releases/tag/{tag}"
    docs_url = "https://docs.projectbluefin.io/changelogs"

    # ── Component chips ──
    chips = []
    for name, info in key_components.items():
        ver    = info["version"]
        change = info["change"]
        if "→" in change:
            old_ver = change.split("→")[0].strip().strip("`")
            chips.append(chip_html(name, ver, old_ver=old_ver))
        else:
            chips.append(chip_html(name, ver))

    # ── SBOM note banner ──
    sbom_banner = ""
    if sbom_note:
        sbom_banner = (
            f'<div class="sbom-note">'
            f'<strong>⚠ SBOM baseline note:</strong> Your running image ({h(booted_date)}) '
            f'predates the release automation — no SBOM exists for it. '
            f'Diff shown is <code>{h(from_tag)}</code> → <code>{h(to_tag)}</code>, '
            f'the nearest available baseline.'
            f'</div>'
        )

    # ── Package diff tables ──

    # Updated
    updated_rows = []
    for name in sorted(changed):
        old, new = changed[name]
        link_info = sbom_pkg_link(name)
        link_cell = ""
        if link_info:
            _, repo, tag_fn = link_info
            url = f"https://github.com/{repo}/compare/{tag_fn(old)}...{tag_fn(new)}"
            link_cell = f'<a href="{h(url)}" target="_blank">diff ↗</a>'
        updated_rows.append(
            f'<tr>'
            f'<td class="pkg-name">{h(name)}</td>'
            f'<td class="ver-old">{h(old)}</td>'
            f'<td class="ver-new">{h(new)}</td>'
            f'<td class="diff-link">{link_cell}</td>'
            f'</tr>'
        )

    # Added
    added_rows = []
    for name in sorted(added):
        ver = added[name]
        link_info = sbom_pkg_link(name)
        link_cell = ""
        if link_info:
            _, repo, tag_fn = link_info
            url = f"https://github.com/{repo}/releases/tag/{tag_fn(ver)}"
            link_cell = f'<a href="{h(url)}" target="_blank">release ↗</a>'
        added_rows.append(
            f'<tr>'
            f'<td class="pkg-name">{h(name)}</td>'
            f'<td class="ver-add">{h(ver)}</td>'
            f'<td class="diff-link">{link_cell}</td>'
            f'</tr>'
        )

    # Removed
    removed_rows = []
    for name in sorted(removed):
        removed_rows.append(
            f'<tr>'
            f'<td class="pkg-name">{h(name)}</td>'
            f'<td class="ver-rem">{h(removed[name])}</td>'
            f'<td class="diff-link"></td>'
            f'</tr>'
        )

    diff_html = ""
    if not updated_rows and not added_rows and not removed_rows:
        diff_html = '<p style="color:var(--ifm-color-emphasis-600);font-size:.85rem">No package differences found between the two SBOMs.</p>'
    else:
        diff_html += diff_section_html("Updated", "updated", updated_rows, ["Package", "Old", "New", ""])
        diff_html += diff_section_html("Added",   "added",   added_rows,   ["Package", "Version", ""])
        diff_html += diff_section_html("Removed", "removed", removed_rows, ["Package", "Version", ""])

    page = f"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Bluefin Dakota — Pending Update {h(tag)}</title>
<style>{HTML_CSS}</style>
</head>
<body>
<div class="page">

  <!-- ── Page header ── -->
  <header class="page-header">
    <div class="page-header-left">
      <h1 class="page-title">Bluefin Dakota</h1>
      <p class="page-subtitle">Pending update — {h(format_date(staged_date))}</p>
      <div class="digest-row">
        <span class="date">{h(booted_date)}</span>
        <span class="tag">{h(booted_digest)}…</span>
        <span class="arrow">→</span>
        <span class="date">{h(staged_date)}</span>
        <span class="tag">{h(staged_digest)}…</span>
        <span style="margin-left:.25rem">
          <a href="{h(gh_url)}" target="_blank" style="font-size:.75rem">{h(tag)}</a>
        </span>
      </div>
    </div>
    <img src="{DAKOTA_IMG}" alt="Dakotaraptor" width="96" height="96">
  </header>

  <!-- ── Component versions ── -->
  <section class="section">
    <h2 class="section-heading">Component Versions</h2>
    <div class="chipsRow_wIOg">
      {"".join(chips)}
    </div>
    <p style="margin-top:.75rem;font-size:.75rem;color:var(--ifm-color-emphasis-600)">
      Highlighted chips have changed — click to view the diff or changelog.
    </p>
  </section>

  <!-- ── Package diff ── -->
  <section class="section">
    <h2 class="section-heading">Package Diff (SBOM)</h2>
    {sbom_banner}
    {diff_html}
  </section>

  <!-- ── Footer ── -->
  <div class="page-footer">
    <a href="{docs_url}" class="viewLink_xgng" target="_blank">Full changelog →</a>
    <a href="{h(gh_url)}" class="viewLink_xgng" target="_blank">View on GitHub →</a>
  </div>

</div>
</body>
</html>"""

    with open(output_path, "w") as f:
        f.write(page)
    return output_path


# ── Rich TUI helpers ──────────────────────────────────────────────────────────

def build_header_panel(booted_date, staged_date, booted_digest, staged_digest):
    t = Table.grid(padding=(0, 2))
    t.add_column(style="dim")
    t.add_column()
    t.add_row("Current", f"[cyan]{booted_date}[/cyan]  [dim]{booted_digest}…[/dim]")
    t.add_row("Staged",  f"[green bold]{staged_date}[/green bold]  [dim]{staged_digest}…[/dim]")
    return Panel(t, title="[bold]Bluefin Dakota — Pending Update[/bold]",
                 border_style="blue", padding=(1, 2))


def build_components_table(key_components):
    t = Table(box=box.ROUNDED, border_style="dim", show_header=True, header_style="bold")
    t.add_column("Component", style="bold cyan", min_width=18)
    t.add_column("Version", min_width=12)
    t.add_column("Change", min_width=30)
    for comp, info in key_components.items():
        ver = info["version"]
        change = info["change"]
        if "→" in change:
            old_ver = change.split("→")[0].strip().strip("`")
            new_ver = change.split("→")[1].strip().strip("`")
            ct = Text()
            ct.append(old_ver, style="dim red strike")
            ct.append(" → ", style="dim")
            ct.append(new_ver, style="green bold")
            t.add_row(comp, ver, ct)
        else:
            t.add_row(comp, f"[dim]{ver}[/dim]", Text("—", style="dim"))
    return t


def build_diff_panels(changed, added, removed):
    panels = []
    if changed:
        t = Table(box=box.SIMPLE_HEAD, header_style="bold yellow", show_header=True)
        t.add_column("Package", style="bold", min_width=30)
        t.add_column("Old", style="dim red", min_width=18)
        t.add_column("New", style="green bold", min_width=18)
        for name in sorted(changed):
            old, new = changed[name]
            panels_row_old = (old[:24] + "…") if len(old) > 26 else old
            panels_row_new = (new[:24] + "…") if len(new) > 26 else new
            t.add_row(name, panels_row_old, panels_row_new)
        panels.append(Panel(t, title=f"[yellow bold]Updated ({len(changed)})[/yellow bold]",
                            border_style="yellow"))
    if added:
        t = Table(box=box.SIMPLE_HEAD, header_style="bold green", show_header=True)
        t.add_column("Package", style="bold", min_width=30)
        t.add_column("Version", style="green", min_width=18)
        for name in sorted(added)[:40]:
            t.add_row(name, added[name])
        if len(added) > 40:
            t.add_row(f"[dim]… and {len(added) - 40} more[/dim]", "")
        panels.append(Panel(t, title=f"[green bold]Added ({len(added)})[/green bold]",
                            border_style="green"))
    if removed:
        t = Table(box=box.SIMPLE_HEAD, header_style="bold red", show_header=True)
        t.add_column("Package", style="bold", min_width=30)
        t.add_column("Version", style="dim red", min_width=18)
        for name in sorted(removed)[:40]:
            t.add_row(name, removed[name])
        if len(removed) > 40:
            t.add_row(f"[dim]… and {len(removed) - 40} more[/dim]", "")
        panels.append(Panel(t, title=f"[red bold]Removed ({len(removed)})[/red bold]",
                            border_style="red"))
    return panels


# ── Main ──────────────────────────────────────────────────────────────────────

def main():
    args = parse_args()
    console = Console()

    with console.status("[bold blue]Querying bootc status…"):
        status = get_bootc_status()

    booted = status["status"].get("booted", {})
    staged = status["status"].get("staged", {})

    if not staged:
        console.print(Panel("[green]No staged update — you are up to date.[/green]",
                            border_style="green"))
        return

    booted_ts    = booted.get("image", {}).get("timestamp", "")
    staged_ts    = staged.get("image", {}).get("timestamp", "")
    booted_digest = booted.get("image", {}).get("imageDigest", "").removeprefix("sha256:")[:20]
    staged_digest = staged.get("image", {}).get("imageDigest", "").removeprefix("sha256:")[:20]
    booted_date  = booted_ts[:10] if booted_ts else "unknown"
    staged_date  = staged_ts[:10] if staged_ts else "unknown"

    console.print()
    console.print(build_header_panel(booted_date, staged_date, booted_digest, staged_digest))

    with console.status("[bold blue]Fetching releases from GitHub…"):
        releases = fetch_releases()

    current_release = find_release_for_date(releases, booted_date)
    staged_release  = find_release_for_date(releases, staged_date)

    if not staged_release:
        console.print(f"[red]No GitHub release found near staged date {staged_date}.[/red]")
        for r in releases[:10]:
            console.print(f"  {r['tag_name']}  ({r['published_at'][:10]})")
        sys.exit(1)

    body           = staged_release.get("body", "")
    key_components = parse_key_components(body)

    summary = ""
    for line in body.splitlines():
        s = line.strip()
        if s.startswith("**") and any(w in s for w in ["updated", "added", "removed"]):
            summary = re.sub(r'\*+', '', s).strip()
            break

    console.print(Panel(
        build_components_table(key_components) if key_components
        else Text("No component version table found.", style="dim"),
        title=(f"[bold]Release Notes: [cyan]{staged_release['tag_name']}[/cyan][/bold]"
               + (f"  [dim]{summary}[/dim]" if summary else "")),
        border_style="cyan", padding=(1, 2)
    ))

    # SBOM
    sbom_note = None
    from_tag  = None
    if not current_release:
        earliest      = releases[-1]["tag_name"] if releases else "none"
        current_release = releases[-1]
        from_tag      = current_release["tag_name"]
        sbom_note     = (
            f"[yellow]Booted image ({booted_date}) predates release automation "
            f"(first release: [bold]{earliest}[/bold]).[/yellow]\n"
            f"[dim]Showing diff from nearest available baseline.[/dim]"
        )
    else:
        from_tag = current_release["tag_name"]

    with console.status(f"[bold blue]Downloading SBOM: {current_release['tag_name']}…"):
        current_sbom = download_sbom(current_release)
    with console.status(f"[bold blue]Downloading SBOM: {staged_release['tag_name']}…"):
        staged_sbom  = download_sbom(staged_release)

    changed = added = removed = {}
    if current_sbom and staged_sbom:
        current_pkgs = extract_packages(current_sbom)
        staged_pkgs  = extract_packages(staged_sbom)
        added, removed, changed = diff_packages(current_pkgs, staged_pkgs)

    diff_panels = build_diff_panels(changed, added, removed)
    if not diff_panels:
        diff_panels = [Text("No package differences found between the two SBOMs.", style="dim")]

    inner = []
    if sbom_note:
        inner.append(Text.from_markup(sbom_note))
        inner.append(Rule(style="dim"))
    inner.extend(diff_panels)

    console.print(Panel(
        Group(*inner),
        title=(f"[bold]Package Diff[/bold]  "
               f"[dim]{from_tag} → {staged_release['tag_name']}[/dim]"),
        border_style="magenta", padding=(1, 2)
    ))

    footer = Table.grid(padding=(0, 2))
    footer.add_column(style="dim")
    footer.add_column(style="blue underline")
    footer.add_row("Full changelog", "https://docs.projectbluefin.io/changelogs")
    footer.add_row("Release page",
                   f"https://github.com/{REPO}/releases/tag/{staged_release['tag_name']}")
    console.print(Panel(footer, border_style="dim", padding=(0, 2)))

    html_path = args.html
    if args.open and not html_path:
        import tempfile
        fd, html_path = tempfile.mkstemp(suffix=".html", prefix="bluefin-changelog-")
        os.close(fd)

    if html_path:
        out = generate_html(
            booted_date, staged_date, booted_digest, staged_digest,
            staged_release, key_components,
            changed, added, removed,
            sbom_note, from_tag, staged_release["tag_name"],
            html_path
        )
        if args.html:
            console.print(f"[dim]HTML written to {out}[/dim]")
        if args.open:
            subprocess.Popen(["xdg-open", html_path])


if __name__ == "__main__":
    main()
