# ── Per-component link resolver ───────────────────────────────────────────────
#  Each entry: release_url(ver) and compare_url(old, new)
def _gh(repo, tag=lambda v: f"v{v}"):
    return {
        "release": lambda v: f"https://github.com/{repo}/releases/tag/{tag(v)}",
        "compare":  lambda o, n: f"https://github.com/{repo}/compare/{tag(o)}...{tag(n)}",
    }

def _gl(host, repo, tag=lambda v: v):
    return {
        "release": lambda v: f"https://{host}/{repo}/-/releases/{tag(v)}",
        "compare":  lambda o, n: f"https://{host}/{repo}/-/compare/{tag(o)}...{tag(n)}",
    }

COMPONENT_LINKS = {
    "Kernel": {
        # kernelnewbies for major bumps; kernel.org changelog for stable patches
        "release": lambda v: (
            f"https://kernelnewbies.org/Linux_{'.'.join(v.split('.')[:2])}"
        ),
        "compare": lambda o, n: (
            f"https://kernelnewbies.org/Linux_{'.'.join(n.split('.')[:2])}"
            if o.split('.')[0] != n.split('.')[0]
            else f"https://cdn.kernel.org/pub/linux/kernel/v{n.split('.')[0]}.x/ChangeLog-{n}"
        ),
    },
    "GNOME":        {"release": lambda v: f"https://release.gnome.org/",
                     "compare":  lambda o, n: f"https://release.gnome.org/"},
    "Mesa":         _gl("gitlab.freedesktop.org", "mesa/mesa",   lambda v: f"mesa-{v}"),
    "Podman":       _gh("containers/podman"),
    "bootc":        _gh("containers/bootc"),
    "systemd":      _gh("systemd/systemd"),
    "pipewire":     _gl("gitlab.freedesktop.org", "pipewire/pipewire"),
    "flatpak":      _gh("flatpak/flatpak",         lambda v: v),   # no v prefix
    "sudo-rs": {
        # version is a commit sha — link to the commit
        "release": lambda v: f"https://github.com/trifectatechfoundation/sudo-rs/commit/{v}",
        "compare":  lambda o, n: f"https://github.com/trifectatechfoundation/sudo-rs/compare/{o}...{n}",
    },
    "uutils":       _gh("uutils/coreutils"),
    "distrobox":    _gh("89luca89/distrobox",      lambda v: v),
    "ghostty":      _gh("ghostty-org/ghostty"),
    "fish":         _gh("fish-shell/fish-shell",   lambda v: v),
    "common": {
        "release": lambda v: f"https://github.com/ublue-os/config/releases",
        "compare":  lambda o, n: f"https://github.com/ublue-os/config/releases",
    },
    "JetBrains Mono": _gh("JetBrains/JetBrainsMono"),
    "gum":          _gh("charmbracelet/gum"),
    "fzf":          _gh("junegunn/fzf"),
    "glow":         _gh("charmbracelet/glow"),
}

def component_url(name, ver, old_ver=None):
    """Return the best URL for a component chip — compare if changed, release otherwise."""
    info = COMPONENT_LINKS.get(name)
    if not info:
        return None
    if old_ver and old_ver != ver:
        return info["compare"](old_ver, ver)
    return info["release"](ver)


